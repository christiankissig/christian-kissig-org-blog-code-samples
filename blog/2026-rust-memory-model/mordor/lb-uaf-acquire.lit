// LB+UAF with Acquire loads only. Under C++20 this is not enough: a relaxed
// store read by an Acquire load creates no synchronisation.
rC := malloc(1);
*rC := 0;
y := 0;
{
  r0 := x.load(acq);
  y.store(1, rlx);
  if (r0 = 1) { free(rC); }
}
|||
{
  r1 := y.load(acq);
  x.store(1, rlx);
  if (r1 = 1) { rv := *rC; }
}
%%
allow (ub) []
